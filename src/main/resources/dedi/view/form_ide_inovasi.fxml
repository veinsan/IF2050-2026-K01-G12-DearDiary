<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dedi.view.FormIdeInovasiView"
            prefWidth="880" prefHeight="680"
            stylesheets="@../css/app.css">

    <!-- ===== Top navigation bar ===== -->
    <top>
        <HBox styleClass="navbar">
            <Label text="DearDiary" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- ===== Scrollable form body ===== -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox styleClass="content-area" spacing="16">

                <!-- Page heading -->
                <Label fx:id="titleLabel" styleClass="page-title"/>

                <!-- ── Auto-generated fields (read-only display) ── -->
                <VBox styleClass="card" spacing="0">
                    <Label text="INFORMASI OTOMATIS" styleClass="section-title"
                           style="-fx-padding: 0 0 8 0;"/>

                    <HBox spacing="48">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="KODE INOVASI" styleClass="field-label"/>
                            <Label fx:id="kodeInovasiLabel"
                                   styleClass="field-value-readonly"
                                   text="Akan digenerate otomatis"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="TANGGAL DIBUAT" styleClass="field-label"/>
                            <Label fx:id="tanggalLabel"
                                   styleClass="field-value-readonly"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ── Main input fields ── -->
                <VBox styleClass="card" spacing="0">
                    <Label text="DATA IDE INOVASI" styleClass="section-title"
                           style="-fx-padding: 0 0 12 0;"/>

                    <!-- Judul (mandatory) -->
                    <Label text="JUDUL  *" styleClass="field-label"/>
                    <TextField fx:id="judulField"
                               styleClass="form-field"
                               promptText="Judul ide inovasi (wajib diisi)"/>

                    <!-- Kategori -->
                    <Label text="KATEGORI" styleClass="field-label"/>
                    <TextField fx:id="kategoriField"
                               styleClass="form-field"
                               promptText="Kategori (e.g. Energi, Kesehatan…)"/>

                    <!-- Deskripsi -->
                    <Label text="DESKRIPSI" styleClass="field-label"/>
                    <TextArea fx:id="deskripsiArea"
                              styleClass="form-field"
                              promptText="Deskripsikan ide inovasi secara singkat…"
                              prefRowCount="4"
                              wrapText="true"/>

                    <!-- Penanggung Jawab -->
                    <Label text="PENANGGUNG JAWAB" styleClass="field-label"/>
                    <TextField fx:id="penanggungJawabField"
                               styleClass="form-field"
                               promptText="Nama penanggung jawab"/>

                    <!-- Prioritas & Status in one row -->
                    <HBox spacing="24">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="PRIORITAS" styleClass="field-label"/>
                            <ComboBox fx:id="prioritasCombo" maxWidth="Infinity" prefWidth="200"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="STATUS" styleClass="field-label"/>
                            <ComboBox fx:id="statusCombo" maxWidth="Infinity" prefWidth="200"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Feedback messages -->
                <Label fx:id="errorLabel"
                       styleClass="error-label"
                       visible="false" managed="false"
                       wrapText="true"/>
                <Label fx:id="successLabel"
                       styleClass="success-label"
                       visible="false" managed="false"/>

                <!-- Action buttons -->
                <HBox spacing="12">
                    <Button text="Simpan"
                            styleClass="primary-button"
                            defaultButton="true"
                            onAction="#handleSimpan"/>
                    <Button text="Batal"
                            styleClass="secondary-button"
                            cancelButton="true"
                            onAction="#handleBatal"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
