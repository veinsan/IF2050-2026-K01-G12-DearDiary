<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dedi.view.DasborView"
            stylesheets="@../css/app.css">

    <!-- ===== Top navigation bar ===== -->
    <top>
        <HBox styleClass="navbar">
            <Label text="DearDiary" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="usernameLabel" styleClass="nav-username"/>
            <Label fx:id="roleLabel"     styleClass="nav-role"/>
            <Button text="Keluar" styleClass="back-button" onAction="#handleLogout"
                    style="-fx-padding: 6 14 6 14;"/>
        </HBox>
    </top>

    <!-- ===== Main content ===== -->
    <center>
        <VBox styleClass="content-area">

            <!-- Toolbar: title + search + add -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Daftar Ide Inovasi" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField"
                           styleClass="form-field"
                           promptText="Cari judul, kode, penulis…"
                           prefWidth="240"
                           onAction="#handleSearch"/>
                <Button text="Cari"
                        styleClass="secondary-button"
                        onAction="#handleSearch"/>
                <TextField fx:id="filterKategoriField"
                           styleClass="form-field"
                           promptText="Filter kategori"
                           prefWidth="180"/>
                <ComboBox fx:id="filterStatusCombo"
                          prefWidth="140"
                          promptText="Semua status"/>
                <Button text="Saring"
                        styleClass="secondary-button"
                        onAction="#handleFilter"/>
                <Button fx:id="tambahIdeButton"
                        text="+ Tambah Ide"
                        styleClass="primary-button"
                        onAction="#handleTambahIde"/>
            </HBox>

            <Label text="Klik dua kali pada baris untuk membuka detail proyek."
                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>

            <!-- Project table (grows to fill remaining height) -->
            <TableView fx:id="daftarIdeListView"
                       styleClass="ide-table"
                       VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Tidak ada data ide inovasi." styleClass="empty-label"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="kodeCol"     text="Kode Inovasi" prefWidth="200"/>
                    <TableColumn fx:id="judulCol"    text="Judul"        prefWidth="300"/>
                    <TableColumn fx:id="penulisCol"  text="Penulis"      prefWidth="140"/>
                    <TableColumn fx:id="statusCol"   text="Status"       prefWidth="110"/>
                    <TableColumn fx:id="prioritasCol" text="Prioritas"   prefWidth="110"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
