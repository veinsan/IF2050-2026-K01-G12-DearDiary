<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dedi.view.PrototipeFormView"
            prefWidth="880" prefHeight="680"
            stylesheets="@../css/app.css">

    <top>
        <HBox styleClass="navbar">
            <Label text="DearDiary" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Kembali" styleClass="back-button" onAction="#handleBatal"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox styleClass="content-area" spacing="16">

                <VBox spacing="4">
                    <Label text="Kelola Riwayat Prototipe" styleClass="page-title"/>
                    <Label fx:id="judulProyekLabel" text="Memuat judul proyek..." style="-fx-text-fill: #666666; -fx-font-size: 14px;"/>
                </VBox>

                <VBox styleClass="card" spacing="12">
                    <Label text="RIWAYAT VERSI" styleClass="section-title"/>

                    <TableView fx:id="tbl_prototipe" prefHeight="200" styleClass="ide-table">
                        <columns>
                            <TableColumn fx:id="colVersi" text="Versi" prefWidth="100"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="colTanggal" text="Tanggal" prefWidth="150"/>
                            <TableColumn fx:id="colDeskripsi" text="Deskripsi Perubahan" prefWidth="380"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox styleClass="card" spacing="16">
                    <Label text="TAMBAH VERSI BARU" styleClass="section-title"
                           style="-fx-padding: 0 0 4 0;"/>

                    <HBox spacing="24">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="VERSI *" styleClass="field-label"/>
                            <TextField fx:id="txtVersi"
                                       styleClass="form-field"
                                       promptText="Contoh: v1.0, v1.1 (wajib diisi)"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="STATUS PROTOTIPE" styleClass="field-label"/>
                            <ComboBox fx:id="choiceStatus" maxWidth="Infinity" prefWidth="200"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="DESKRIPSI PERUBAHAN" styleClass="field-label"/>
                        <TextArea fx:id="txt_deskripsi_perubahan"
                                  styleClass="form-field"
                                  promptText="Jelaskan perubahan fisik atau teknis pada versi ini..."
                                  prefRowCount="4"
                                  wrapText="true"/>
                    </VBox>
                </VBox>

                <Label fx:id="errorLabel"
                       styleClass="error-label"
                       visible="false" managed="false"
                       wrapText="true"/>
                <Label fx:id="successLabel"
                       styleClass="success-label"
                       visible="false" managed="false"/>

                <HBox spacing="12">
                    <Button fx:id="btn_simpan_versi"
                            text="Simpan Versi"
                            styleClass="primary-button"
                            defaultButton="true"
                            onAction="#handleSimpan"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>